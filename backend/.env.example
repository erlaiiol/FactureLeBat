# For native (non-Docker) dev: run `docker compose -f infra/docker-compose.yml up -d postgres`
# first, then point this at its published port (see infra/.env's POSTGRES_PORT).
DATABASE_URL="postgresql://facturele:facturele@localhost:5432/facturele?schema=public"

# All optional — defaults shown. Validated at boot by src/config/env.validation.ts;
# the app refuses to start if any of these are set but malformed.
# NODE_ENV=development
# PORT=3000
# CORS_ORIGIN=http://localhost:4200

# Defaults to 'debug' in development, 'info' in production. See docs/logging.md.
# LOG_LEVEL=debug

# Phase 10 sourcing assistant. Leave GROQ_API_KEY unset to run the app with
# the feature disabled (POST /sourcing/* replies 503) — everything else
# works normally without it. Get a free key at https://console.groq.com.
# GROQ_API_KEY=<get-a-free-key-at-console.groq.com>
# SOURCING_DAILY_SEARCH_CAP=20

# Phase 1.4-1 voice/chat invoice drafting. Provider-agnostic on purpose
# (see backend/src/invoice-voice-draft/llm/) — LLM_API_KEY/LLM_MODEL are
# read by whichever LlmClient implementation is currently bound in
# invoice-voice-draft.module.ts (Anthropic today). Leave LLM_API_KEY unset
# to run the app with the feature disabled (POST /invoices/voice-draft
# replies 503) — everything else works normally without it. Get an
# Anthropic key at https://console.anthropic.com.
# LLM_API_KEY=<get-a-key-at-console.anthropic.com>
# LLM_MODEL=claude-sonnet-5
# VOICE_DRAFT_DAILY_CAP=30

# Phase 12 invoice mailing. Leave unset to run the app with the feature
# disabled (PATCH /mail-settings and POST /invoices/:id/send-email reply
# 503) — everything else works normally without it. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_ENCRYPTION_KEY=

# Phase 13 auth. NOT optional, unlike the vars above — the app refuses to
# boot without it (same posture as DATABASE_URL). Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# JWT_ACCESS_SECRET=

# All optional — defaults shown.
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN_DAYS=30
# JWT_REFRESH_NOT_REMEMBERED_EXPIRES_IN_DAYS=1

# Where the frontend runs — used to redirect back after Google OAuth and to
# build the links in verification/password-reset emails.
# FRONTEND_URL=http://localhost:4200

# Phase 13 Google OAuth. Leave both unset to run the app with Google login
# disabled (GET /auth/google* replies 503) — email/password auth still
# works normally without it. Create credentials at
# https://console.cloud.google.com/apis/credentials.
# GOOGLE_CLIENT_ID=<create-oauth-credentials-at-console.cloud.google.com>
# GOOGLE_CLIENT_SECRET=<create-oauth-credentials-at-console.cloud.google.com>
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Phase 1.5 Sign in with Apple — native-only (iOS app), no browser-redirect
# route exists for this one. Leave APPLE_CLIENT_ID unset to run with Apple
# login disabled (POST /auth/apple/token-login replies 503).
# APPLE_CLIENT_ID is the app's own bundle ID (fr.facturele.app), not a
# separate Services ID — the native flow's identity token already carries
# that as its `aud` claim. Requires the "Sign In with Apple" capability
# enabled on the App ID at https://developer.apple.com/account/resources/identifiers/list,
# nothing else.
# APPLE_CLIENT_ID=fr.facturele.app
#
# The three below are optional even with Apple login enabled — only needed
# so account deletion can revoke the artisan's Apple grant (guideline
# 5.1.1(v)), never to log in. Create a Sign in with Apple key at
# https://developer.apple.com/account/resources/authkeys/list (Team ID is
# on the membership page, Key ID is shown once the key is created, the
# downloaded .p8 file's contents go into APPLE_PRIVATE_KEY with real
# newlines replaced by literal \n so it fits on one line).
# APPLE_TEAM_ID=<from-your-apple-developer-membership-page>
# APPLE_KEY_ID=<from-the-key-you-create-at-developer.apple.com>
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Phase 13 transactional email (account verification, password reset) — the
# app's own system mailbox, deliberately separate from Phase 12's
# mail-settings (which sends invoices from the *artisan's own* address).
# Leave unset to run with these emails disabled (POST /auth/forgot-password
# and /auth/resend-verification reply 503) — registration/login still work
# normally without it. Using OVH mail hosting — host ssl0.ovh.net (or
# proX.mail.ovh.net for an "Emails Pro"/Exchange offer, check the OVH
# manager), port 465, secure true, user/password are the real OVH mailbox
# credentials (not an API key).
# SYSTEM_SMTP_HOST=<your-smtp-provider-host>
# SYSTEM_SMTP_PORT=587
# SYSTEM_SMTP_SECURE=false
# SYSTEM_SMTP_USER=<your-system-mailbox-username>
# SYSTEM_SMTP_PASSWORD=<your-system-mailbox-password-or-app-password>
# SYSTEM_MAIL_FROM_NAME=FactureLe
# SYSTEM_MAIL_FROM_ADDRESS=<address-emails-are-sent-from>

# Phase 14 Stripe subscription billing, 3 tiers as of Phase 30 (Essentiel
# 7€ / Pro 12€ / Premium 15€ — see docs/roadmap.md Phase 30's "Stripe
# dashboard setup" section for how to create the 3 Prices). Leave
# STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET unset to run the app with billing
# disabled (POST /billing/checkout-session, /portal-session and /webhook
# reply 503) — the free-trial gate still blocks a company's 2nd invoice,
# there's just no way to pay to lift it yet. Each price id below is
# independently optional: set only STRIPE_PRICE_ID_PREMIUM to reproduce the
# pre-Phase-30 single-tier behavior exactly. Forward webhooks locally with
# `stripe listen --forward-to localhost:3000/api/billing/webhook`.
# STRIPE_PUBLIC_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=<whsec_...>
# STRIPE_PRICE_ID_ESSENTIEL=<price_...>
# STRIPE_PRICE_ID_PRO=<price_...>
# STRIPE_PRICE_ID_PREMIUM=<price_...>

# Phase 30: time-boxed "offre de lancement" on Premium only (15€ -> 10€ for
# 2 months). Leave unset to keep the offer off. ISO 8601 date.
# LAUNCH_OFFER_EXPIRES_AT=2026-10-01T00:00:00Z

# Phase 14 admin bootstrap. Leave unset and no account is ever promoted —
# see admin/admin-seed.service.ts. Set to an email already registered in
# this deployment; re-runs on every boot are a no-op once applied.
# ADMIN_SEED_EMAIL=<you@example.com>

# Phase 1.2-4 e-invoicing transmission (SUPER PDP, the chosen PA — see
# docs/roadmap.md Phase 1.2-1). Leave unset to run the app with PA
# transmission disabled (POST /invoices/:id/transmit and the
# /company/super-pdp/* connect routes reply 503) — Factur-X download (Phase
# 1.2-3) still works normally without it.
# TODO before going live with this feature:
#   1. Create a SUPER PDP account at https://www.superpdp.tech/ and register
#      as a software editor/partner (their public API reference is at
#      https://www.superpdp.tech/openapi/) to get a client id/secret.
#   2. SUPER PDP requires OAuth2.1 Authorization Code flow for a
#      multi-tenant app like FactureLe — each artisan grants their own
#      consent on top of these app-level credentials, see
#      docs/roadmap.md Phase 1.2-4.
#   3. Set SUPERPDP_REDIRECT_URI to match whatever you registered with them.
#   4. After an artisan connects, SUPER PDP runs its own KYB review before
#      the connection is actually usable (minutes to days) — a backend cron
#      (SuperPdpProvisioningCronService) picks it up automatically once
#      verified, nothing to configure for this step.
# SUPERPDP_CLIENT_ID=
# SUPERPDP_CLIENT_SECRET=
# SUPERPDP_REDIRECT_URI=http://localhost:3000/api/company/super-pdp/callback

# Phase 22 push notifications (Capacitor mobile app). Leave unset to run
# the app with push disabled — device registration still works, sending
# just no-ops/503s (see push-notification/push-sender.service.ts). Both
# iOS and Android route through FCM, so only a Firebase service account is
# needed here, never a separate APNs key. Create a Firebase project, add
# both apps (bundle/package id fr.facturele.app), download the service
# account JSON from Project Settings > Service Accounts, then:
#   base64 -i service-account.json | tr -d '\n'
# NEVER commit the raw JSON file itself.
# FIREBASE_SERVICE_ACCOUNT_JSON=<base64-encoded-service-account-json>
