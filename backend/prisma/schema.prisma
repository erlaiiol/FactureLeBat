generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LegalStatus {
  MICRO_ENTREPRENEUR
  COMPANY
}

// The curated, fixed vocabulary of units an artisan can bill in (Phase 7 —
// replaces a free-text unit field). Only SQUARE_METER carries area
// semantics (waste surcharge eligible); every other unit bills as a plain
// quantity x unit price. See backend/src/common/unit.util.ts for the
// French display labels and the isAreaUnit() predicate derived from this.
enum Unit {
  SQUARE_METER
  LINEAR_METER
  UNIT
  LUMP_SUM
  HOUR
  DAY
  KILOGRAM
  LITER
  CUBIC_METER
}

enum WasteSurcharge {
  NONE
  TEN
  TWENTY
}

enum ServiceVisibility {
  VISIBLE
  REDISTRIBUTED
}

// Phase 32: which of the two a catalog Discount/InvoiceDiscountLine's value
// means — a plain euro amount (FIXED) or a share of the invoice's product +
// visible-service subtotal, before VAT (PERCENTAGE). Same "resolved once at
// add-time, never a live formula" precedent as Service.pricingMode
// PERCENTAGE: a PERCENTAGE discount is converted to a concrete amountCents
// client-side the moment it's added to an invoice draft, and
// InvoiceDiscountLine below only ever stores that resolved amountCents.
enum DiscountType {
  PERCENTAGE
  FIXED
}

// Phase 13.5: how a catalog Service's contribution to an invoice is priced.
// FIXED (default, pre-existing behavior) is a typed euro amount (priceCents).
// PERCENTAGE stores a share of the invoice instead (percentageBasisPoints,
// same basis-point convention as Company.vatRateBasisPoints) — e.g. an
// artisan's own "Marge 30%" service, reused on every invoice instead of
// recomputing a markup by hand each time. Exactly one of priceCents/
// percentageBasisPoints is meaningful per mode (enforced by
// ServicePricingConsistency at the DTO boundary, not the DB).
enum ServicePricingMode {
  FIXED
  PERCENTAGE
}

// Phase 9.5: which input surface authored an invoice's line data. GUIDED
// (default) is the pre-existing catalog/form-driven flow — lines/serviceLines
// below. MANUAL is the free-form PDF-like canvas: its body lives in the
// ManualInvoice* tables instead, and lines/serviceLines simply stay empty.
// Deliberately a field on Invoice rather than a second model — both modes
// share the same numbering sequence, customer fields, VAT snapshot, and PDF
// pipeline; only the line-item shape differs. See docs/roadmap.md Phase 9.5.
enum InvoiceEntryMode {
  GUIDED
  MANUAL
}

// Phase 14.3: a devis is, mechanically, an unconsumed facture — same
// `Invoice` row shape, same creation pipeline, same premium gate. Only the
// document label and the numbering sequence differ (see Company.devisNumberPrefix/
// nextDevisNumber below and Invoice.convertedFromDevisId). Default FACTURE so
// every pre-Phase-14.3 invoice keeps behaving exactly as before.
enum DocumentType {
  DEVIS
  FACTURE
}

// Phase 1.1-8 (2026 e-invoicing reform baseline field): "nature de
// l'opération" — for a GUIDED invoice this is derived at PDF-render time
// (never persisted, see InvoiceMapper) from whether the invoice has product
// `lines` and/or VISIBLE `serviceLines`. MANUAL mode has no such structured
// split to derive from, so its own choice is the one place this enum is
// actually persisted — see Invoice.manualNatureOfOperation.
enum NatureOperation {
  LIVRAISON_BIENS
  PRESTATION_SERVICES
  BIENS_ET_SERVICES
}

// Phase 1.2-4 (2026 e-invoicing reform): FactureLe's own transmission
// lifecycle for a FACTURE sent through a PA — deliberately not the PA's own
// vocabulary (SUPER PDP's own `status_code` is an unordered, ever-growing
// event log, explicitly documented as "not a state machine" — see
// e-invoicing/super-pdp-status.util.ts). A future PA swap only ever touches
// that one translation table, never this enum or anything reading it.
enum EInvoiceTransmissionStatus {
  NOT_SENT
  SENT // api:uploaded — passed the PA's own syntax check
  VALIDATED // api:validated — passed Schematron/semantic checks
  DELIVERED // api:sent / api:received — reached the counterpart access point
  ACCEPTED // api:accepted — counterpart returned no errors
  REJECTED // api:invalid / api:rejected — failed at any stage
}

// Phase 16: an artisan-controlled payment lifecycle for a FACTURE — never
// set/read for a DEVIS (see InvoiceService.updateStatus's documentType
// guard). "En retard" is deliberately not a 4th value here: it's NON_PAYEE +
// Invoice.dueDate in the past, computed at read time (see
// InvoiceMapper/frontend invoice-status.util.ts), same "derived data is
// never persisted" rule as invoice totals — see docs/conventions.md.
//
// Phase 1.1-3: ACOMPTE_VERSE sits between NON_PAYEE and PAYEE — an
// artisan-driven step recording that the requested deposit (see
// Invoice.depositAmountCents below) actually landed, same "the system can't
// observe a bank deposit, so it's a deliberate board action" reasoning as
// every other status here. Only offered as a transition on a facture that
// actually has a deposit set (see InvoiceService.updateStatus). No
// partial-deposit/refund tracking beyond this single flag — see
// docs/roadmap.md Phase 1.1-3's non-goals.
enum InvoiceStatus {
  NON_PAYEE
  ACOMPTE_VERSE
  PAYEE
  ANNULEE
}

// A column of a MANUAL invoice's free-form table. Exactly one DESCRIPTION,
// one QUANTITY, one UNIT_PRICE, and one LINE_TOTAL column exist per manual
// invoice (enforced by CreateManualTableDto, not the DB). Unlike a GUIDED
// line, the row's priced total is never derived from QUANTITY x UNIT_PRICE —
// LINE_TOTAL is the artisan's own freehand price for that row (see
// docs/roadmap.md Phase 9.5's manual-mode principle: totals stay fully
// editable, never computed behind the artisan's back). QUANTITY/UNIT_PRICE
// stay purely informational text on the canvas — free text is allowed (e.g.
// "2 boites"), only used client-side to suggest a LINE_TOTAL value. Any
// further CUSTOM column is free text, rendered on the canvas/PDF but never
// priced.
enum ManualColumnRole {
  DESCRIPTION
  QUANTITY
  UNIT_PRICE
  LINE_TOTAL
  CUSTOM
}

// Phase 10: which kind of AI sourcing call a cached SourcingSearch row is
// for — the two calls have very different cost/nature (a live web search vs.
// a plain knowledge-only completion, see docs/roadmap.md Phase 10) but share
// the same cache/daily-cap plumbing, hence one table with a discriminator
// rather than two near-identical models.
enum SourcingSearchKind {
  SUPPLIER_SEARCH
  COMPLEMENTARY_SUGGESTIONS
}

// Phase 13. ARTISAN is every normal tenant owner; ADMIN is a support/ops
// role introduced now (unused until Phase 14's admin dashboard) so granting
// admin access later needs no further migration.
enum UserRole {
  ARTISAN
  ADMIN
}

// Phase 13: which short-lived, single-use AuthToken a row represents — same
// "one table, two kinds via a discriminator" precedent as SourcingSearchKind
// above, since both purposes share identical create/hash/expire/consume
// plumbing.
enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// Phase 17: which cadence the artisan declares turnover on — a real choice
// auto-entrepreneurs make at URSSAF registration. Purely a UI default (which
// period the report screen preselects); the report itself always accepts an
// explicit from/to range regardless of this value.
enum DeclarationFrequency {
  MENSUELLE
  TRIMESTRIELLE
}

// Phase 17: the URSSAF turnover category a Product/Service/invoice line
// belongs to. Artisan-set only — see docs/roadmap.md Phase 17's "No
// automatic activity-category detection" non-goal. Snapshotted onto
// InvoiceLine/InvoiceServiceLine at creation time (see those models below),
// never re-derived from a live Product/Service join: retroactively
// recategorizing a catalog item must never silently change a quarterly
// report for a period already declared to URSSAF.
enum ActivityCategory {
  VENTE_MARCHANDISES
  PRESTATION_BIC
  PRESTATION_BNC
}

// Phase 14: mirrors the subset of Stripe subscription statuses this app
// actually branches on — NONE (never subscribed, the default) vs. the two
// states a real Stripe subscription can settle in that we care about.
// Deliberately not a 1:1 copy of Stripe's own (much larger) status enum:
// trialing/incomplete/incomplete_expired all collapse into NONE here since
// none of them grant premium access, and Stripe remains the source of truth
// for the raw state — this column is only ever written from a verified
// webhook event (see BillingService.applySubscriptionEvent).
enum SubscriptionStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELED
}

// Phase 30: the three subscription tiers (7€/12€/15€), replacing the
// single flat "premium" plan from Phase 14 — see billing/plan-config.ts for
// the price/cap/feature definition per tier, docs/roadmap.md Phase 30 for
// the decoy-pricing rationale. Declared in ascending order so array index
// doubles as a rank comparison (see PLAN_TIER_ORDER in plan-config.ts).
enum PlanTier {
  ESSENTIEL
  PRO
  PREMIUM
}

model Company {
  id String @id @default(uuid())

  name         String
  siret        String
  addressLine1 String
  addressLine2 String?
  postalCode   String
  city         String
  email        String?
  phone        String?

  // Phase 1.2-2 (2026 e-invoicing reform): the seller VAT-ID node Factur-X/
  // EN16931-family XML expects when the company is VAT-registered. Nullable
  // because a franchise-en-base artisan (see vatOnDebitsOption/legalStatus
  // below) has no VAT number at all — same optional-legal-field pattern as
  // microEntrepreneurCeiling, never forced where none exists.
  vatNumber String?

  legalStatus        LegalStatus
  vatRateBasisPoints Int         @default(2000)

  // First-invoice-pipeline reversal: null until the artisan has explicitly
  // confirmed their VAT regime (via POST /onboarding/confirm-legal-status),
  // distinct from legalStatus/vatRateBasisPoints just holding their default
  // values unconfirmed. Backfilled to the migration's run time for every
  // pre-existing company (they already went through the old full-form
  // gate), so only genuinely new signups are ever asked.
  legalStatusConfirmedAt DateTime?

  // Phase 27: only the prefix is stored here now — the actual next number is
  // computed on demand as (the highest number ever used by this company for
  // this document type) + 1, never from a separately-tracked counter (see
  // next-number.util.ts). This is what lets an artisan freely override a
  // document's number (e.g. to continue a previous software's sequence) and
  // have every following auto-suggestion pick up right after it, with
  // nothing left to fall out of sync. InvoiceRepository still locks this row
  // during creation for concurrency safety, exactly as the old counter did.
  invoiceNumberPrefix String @default("F")

  // Phase 14.3: a devis gets its own independent numbering pool, same
  // reasoning as invoiceNumberPrefix above — French law's numbering rule
  // only binds real factures, but there's no reason to weaken the same
  // guarantee where it isn't legally required.
  devisNumberPrefix String @default("DEV")

  // Phase 8 onboarding tour: tourEnabled is the master on/off switch,
  // completedTours holds the ids (see onboarding/onboarding.constants.ts)
  // of tours the artisan has finished or skipped, so they never resurface
  // uninvited. Left on Company rather than moved to User in Phase 13 since
  // it's still meaningfully "per tenant" (1:1 with User today anyway) and
  // moving it would have been a gratuitous churn with no behavior change.
  tourEnabled    Boolean  @default(true)
  completedTours String[] @default([])

  // Phase 12 invoice mailing: the artisan's own SMTP account, used to send
  // invoices literally from their address (no third-party "From" relay) —
  // see mail-settings/. smtpPasswordEncrypted is ciphertext only (AES-256-GCM,
  // see common/secret-crypto.util.ts), never the plaintext app password.
  // All nullable: mailing is opt-in, an artisan who never configures this
  // keeps downloading/emailing PDFs manually with zero behavior change.
  smtpHost              String?
  smtpPort              Int?
  smtpSecure            Boolean @default(true)
  smtpUser              String?
  smtpPasswordEncrypted String?

  // Phase 1.2-4 (2026 e-invoicing reform): the artisan's own OAuth2 consent
  // to let FactureLe transmit their invoices through SUPER PDP (the chosen
  // PA, see docs/roadmap.md Phase 1.2-1) — one consent per company, not a
  // single FactureLe-wide credential, since SUPER PDP's multi-tenant model
  // requires each end company to individually authorize the software
  // editor via OAuth2's Authorization Code flow. Token fields are ciphertext
  // only (AES-256-GCM, common/secret-crypto.util.ts), same pattern as
  // smtpPasswordEncrypted above. All nullable: connecting a PA is opt-in,
  // same "zero behavior change until configured" precedent as SMTP.
  superPdpAccessTokenEncrypted  String?
  superPdpRefreshTokenEncrypted String?
  superPdpTokenExpiresAt        DateTime?
  superPdpConnectedAt           DateTime?

  // Phase 1.3-1 (2026 e-invoicing reform, workflow automation): how hands-off
  // this artisan wants the e-invoicing pipeline to be — three independent
  // toggles rather than one mode enum, since real preferences don't collapse
  // onto a single manual/automatic axis (e.g. always attaching Factur-X to
  // emails while still personally deciding when something goes to the PA).
  // All default false: Phase 1.2's fully-manual pipeline is unchanged until
  // an artisan explicitly opts into one of these. autoTransmitViaPa/
  // autoSyncReceivedInvoices are only meaningful once SUPER PDP is connected
  // (superPdpConnectedAt above) — enforced server-side in CompanyService,
  // not just hidden in the UI.
  autoAttachFacturX        Boolean @default(false)
  autoTransmitViaPa        Boolean @default(false)
  autoSyncReceivedInvoices Boolean @default(false)

  // A short personal note the artisan writes once, appended to the default
  // invoice/devis message on every send — the native "Partager" share sheet,
  // the SMTP compose modal, and the mailto fallback all read this same value
  // (see buildDefaultInvoiceMailTemplate), so it stays consistent regardless
  // of which of the three the artisan (or their platform) ends up using.
  // Null means no custom line is added, keeping today's message unchanged.
  invoiceMailCustomMessage String?

  // Phase 14: Stripe subscription billing. stripeCustomerId is created lazily
  // (on the first checkout attempt), not at Company creation — most
  // companies never subscribe, and creating a Stripe Customer for every
  // signup would mean an API call (and an orphaned Stripe object) for
  // artisans who never touch billing. subscriptionStatus/currentPeriodEnd/
  // cancelAtPeriodEnd are written exclusively from a verified webhook event
  // (see BillingService) — never optimistically set from the checkout
  // redirect, which only proves the artisan reached Stripe, not that the
  // payment actually completed.
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionStatus   SubscriptionStatus @default(NONE)
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  // Phase 30: which of the 3 tiers the active Stripe subscription above is
  // for, resolved from the subscription's Stripe price id against
  // STRIPE_PRICE_ID_ESSENTIEL/_PRO/_PREMIUM on every webhook event (see
  // BillingService.applySubscriptionEvent) — never trusted from the
  // checkout redirect, same reasoning as subscriptionStatus itself. Null
  // whenever subscriptionStatus is NONE/CANCELED, or if a subscription
  // exists on a price id that doesn't match any configured tier (never
  // downgraded/guessed in that case — see PlanGateService).
  subscriptionPlanTier PlanTier?

  // Premium access granted outside Stripe — an admin's manual grant or a
  // redeemed PromoCode, both funnel through these two fields together (see
  // BillingRepository.grantPlanDays). Independent of subscriptionStatus: an
  // artisan can have both an active subscription AND a grant layered on
  // top (e.g. a referral bonus applied while already paying), so
  // PlanGateService.getEffectivePlanTier takes the higher of the two,
  // never one exclusively. grantedPlanTier is only meaningful while
  // premiumGrantedUntil is still in the future.
  premiumGrantedUntil DateTime?
  grantedPlanTier     PlanTier?

  // Phase 29: referral program. The reward is asymmetric — the parrain
  // (referralsMade side) gets a straight 30-day premiumGrantedUntil grant (a
  // fourth way into that field, alongside Stripe/admin grant/promo code
  // above), but the filleul (referredBy side) gets a Stripe coupon instead
  // (15€ -> 10€ off their first billing cycle) — see
  // BillingService.grantReferralDiscount. referralCode is generated once at
  // company creation (UserRepository.createWithCompany), globally unique
  // like PromoCode.code (small cross-tenant catalog, not per-tenant), never
  // regenerated.
  referralCode  String     @unique
  referralsMade Referral[] @relation("Referrer")
  referredBy    Referral?  @relation("Referred")

  // Set instead of applying the filleul's Stripe coupon immediately when
  // this company has no live subscription yet (the normal case — a filleul
  // is, by definition, a brand-new company that hasn't subscribed yet).
  // BillingService.createCheckoutSession attaches the coupon to the next
  // Checkout Session it builds, and the flag is cleared once the resulting
  // subscription is actually confirmed by webhook (BillingService.
  // applySubscriptionEvent) — an abandoned checkout must not burn the
  // reward. No rate limiting needed here beyond that: Referral.
  // referredCompanyId is @@unique, so a company can only ever be a filleul
  // (and therefore only ever get this discount) once.
  pendingReferralDiscount Boolean @default(false)

  // Phase 33: set once, the first time this company's invoice count goes
  // from 0 to 1 (see PlanGateService.recordInvoiceCreated, called from
  // InvoiceService.create()/convertToFacture()) — the deadline for the
  // limited-time "1er mois à 2€" Premium offer shown right after the free
  // trial invoice and again if the artisan hits the paywall before
  // converting. A real, persisted deadline on purpose: never recomputed
  // from "now" on each request, so the countdown the frontend renders
  // can't be reset by revisiting the page — see docs/roadmap.md Phase 33.
  // Never overwritten once set (BillingRepository.startTrialOfferWindow is
  // a conditional update), and left untouched forever after — no need to
  // clear it once it expires or once the company subscribes, since
  // PlanGateService.isTrialOfferActive already checks both the expiry and
  // getEffectivePlanTier.
  trialOfferExpiresAt DateTime?

  // Phase 17: which period the quarterly report screen preselects — see
  // DeclarationFrequency above. microEntrepreneurCeiling (cents) is
  // deliberately artisan-editable, not a hardcoded legal constant: the real
  // plafond depends on activity type and changes over time, and the app
  // can't guarantee a baked-in number stays current. Left null, the report's
  // plafond warning simply doesn't render.
  declarationFrequency     DeclarationFrequency @default(TRIMESTRIELLE)
  microEntrepreneurCeiling Int?

  // Phase 1.1-3: the artisan's habitual acompte rate, basis points (3000 =
  // 30.00%) — same convention as vatRateBasisPoints, editable in company
  // settings. Null means no default: mode rapide/mode manuel's "Demander un
  // acompte" toggle stays off until the artisan opts in per-document; when
  // set, it's the toggle's pre-filled (never locked) starting point on every
  // new FACTURE draft from then on.
  defaultDepositPercentageBasisPoints Int?

  // Phase 17 (charges estimate): the micro-entrepreneur "cotisations
  // sociales" rate per URSSAF turnover category, basis points (1230 =
  // 12.30%) — same convention as vatRateBasisPoints. Pre-filled with the
  // official rates in effect when this was built, but artisan-editable, not
  // a hardcoded constant: these rates are revised periodically (the BIC/BNC
  // rates are also being progressively harmonized with the Cipav rate by a
  // multi-year reform), and a profession affiliated with the Cipav pays a
  // slightly different rate than the general-regime default. Only
  // meaningful when legalStatus is MICRO_ENTREPRENEUR — see
  // ReportsService's estimatedCharges computation. Ignored, but still
  // stored, for a COMPANY (no cost to keep the same three columns).
  cotisationVenteBasisPoints         Int     @default(1230)
  cotisationPrestationBicBasisPoints Int     @default(2120)
  cotisationPrestationBncBasisPoints Int     @default(2110)
  // Whether this micro-entrepreneur opted for the "versement libératoire de
  // l'impôt sur le revenu" at registration (a fixed extra percentage of
  // turnover — 1% / 1.7% / 2.2% by category, in lieu of ordinary
  // progressive-bracket income tax on this activity). Unlike the cotisation
  // rates above, these three percentages are fixed by law with no
  // per-profession variation, so they're plain constants in
  // activity-category.util.ts rather than further editable columns here.
  // Defaults to false: most micro-entrepreneurs don't opt in, and the
  // estimate must not silently add a tax the artisan never actually chose.
  versementLiberatoireOptIn          Boolean @default(false)

  // Mandatory legal mention for BTP (construction) invoices — art. L243-2 du
  // Code des assurances requires a company subject to garantie décennale to
  // state its decennial-liability insurer, policy number and geographic
  // coverage area on every invoice/devis. decennialInsuranceApplicable is
  // the artisan's own declaration of being subject to that obligation (no
  // way to infer it from legalStatus or SIRET); the three detail fields are
  // then required by UpdateCompanyDto's cross-field validation, and
  // PdfService.buildFooter only prints the mention once all three are
  // actually filled in.
  decennialInsuranceApplicable   Boolean @default(false)
  decennialInsurerName           String?
  decennialInsurancePolicyNumber String?
  decennialInsuranceCoverageArea String?

  // Phase 1.1-6: general-purpose free-text footer mention — the escape
  // hatch for any legal/commercial mention this app doesn't model as its
  // own structured field. No format imposed on customFooterMessage; the
  // two toggles are independent (facture-only, devis-only, both, or
  // neither). PdfService.buildFooter renders it as its own centered block
  // only when the toggle matching the current document's documentType is
  // on and the message isn't empty — null/empty message with either
  // toggle on simply renders nothing, same "absent input, no output"
  // precedent as decennialInsurance above.
  customFooterMessage   String?
  customFooterOnFacture Boolean @default(false)
  customFooterOnDevis   Boolean @default(false)

  // Phase 1.1-7: Art. L441-9 du Code de commerce requires a facture to a
  // professional client to *state* the escompte (early-payment discount)
  // policy even when there isn't one — a company that never touches this
  // field must still be compliant, not silently missing a mandatory line.
  // DB-level default (not application logic) is what makes that true for
  // every company, new or existing: this column's default doubles as its
  // "pre-filled on first save" value, applied by Postgres itself to every
  // pre-existing row the moment this migration runs, and to every Company
  // created afterward (see DEFAULT_COMPANY_PROFILE, which sets no value for
  // this field on purpose). Editable afterward like every other footer
  // mention; PdfService.buildFooter only prints it on a FACTURE to a
  // Customer.isProfessional client.
  earlyPaymentDiscountMention String? @default("Pas d'escompte pour paiement anticipé.")

  // Phase 1.1-8 (2026 e-invoicing reform baseline field): "option pour le
  // paiement de la taxe d'après les débits" — same toggle-prints-a-fixed-mention
  // pattern as customFooterOnFacture, FACTURE-only per its own legal
  // wording (a devis collects no tax, so the option is meaningless there).
  vatOnDebitsOption Boolean @default(false)

  invoices         Invoice[]
  sourcingSearches SourcingSearch[]
  customers        Customer[]
  products         Product[]
  services         Service[]
  discounts        Discount[]
  catalogFolders   CatalogFolder[]
  promoRedemptions PromoCodeRedemption[]

  // Company logo (top-right corner of every invoice/devis PDF), kept in its
  // own 1:1 table rather than as columns here — Invoice queries `include:
  // { company: true }` unconditionally (see InvoiceRepository.INVOICE_INCLUDE),
  // so a Bytes column directly on Company would get pulled into every
  // invoice list/board fetch, not just PDF generation. Optional relation:
  // most companies never upload one.
  logo CompanyLogo?

  // Phase 13: the single artisan account that owns this Company. Optional
  // on this side only because Prisma requires a nullable back-relation
  // field syntactically — in practice every Company is created together
  // with its User (UserRepository.createWithCompany) and never orphaned.
  user User?

  // Phase 1.2-5 (2026 e-invoicing reform): supplier e-invoices received
  // through the connected PA — see ReceivedInvoice below.
  receivedInvoices ReceivedInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Phase 1.2-5 (2026 e-invoicing reform): a minimal, read-only record of one
// supplier invoice received through the connected PA (SUPER PDP) —
// satisfies the reform's 2026-09-01 reception obligation. Deliberately an
// island: no relation to Product/Service/activityCategory or Phase 17's
// Quarterly Report/Activity Analytics (see docs/roadmap.md Phase 1.2-5's
// own non-goals — this is store-and-display, not expense/accounting
// tracking). The original file is never stored here — always re-fetched
// live from SUPER PDP on download (GET /v1.beta/invoices/:id?format=
// factur-x), same "derive, don't persist a large blob you can re-fetch"
// reasoning as Company.logo's own separate table, just taken one step
// further since even the blob's *source of truth* stays external.
model ReceivedInvoice {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // SUPER PDP's own id for this incoming invoice — opaque to the rest of
  // the app, used only to re-fetch the original document on demand and as
  // the dedup key when syncing (see ReceivedInvoiceService.sync).
  superPdpInvoiceId String

  // Parsed from SUPER PDP's own EN16931 JSON representation
  // (`en16931` format, the default) — nullable throughout since a supplier
  // invoice reaching this app could in principle be missing any one of
  // these depending on the sender's own compliance, and this app has no way
  // to demand a resend.
  issuerName        String?
  issuerSiret       String?
  number            String?
  issueDate         DateTime?
  totalInclVatCents Int?
  vatAmountCents    Int?
  currencyCode      String?

  receivedAt DateTime @default(now())

  @@unique([companyId, superPdpInvoiceId])
  @@index([companyId])
}

// The artisan's own logo, shown top-right on every invoice/devis PDF —
// see PdfService.buildHeader. Deliberately its own table, not columns on
// Company (see Company.logo's comment): keeps this Bytes payload out of
// every ordinary Company/Invoice read, fetched only where a PDF is actually
// built or the logo is actually served/edited. image is the raw file bytes
// (base64-encoded at the point PdfService/the API response need a data URI,
// never stored pre-encoded — no reason to pay Postgres bytea the ~33%
// base64 overhead at rest).
model CompanyLogo {
  companyId String   @id
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  image     Bytes
  // image/png or image/jpeg only — the two raster formats pdfMake can embed
  // (see PdfService's font/image loading comments); validated at the
  // upload endpoint (CompanyController.uploadLogo), not re-checked here.
  mimeType  String
  updatedAt DateTime @updatedAt
}

// Phase 1.1-1: how a signature proof was captured — see InvoiceSignature
// below.
enum SignatureMethod {
  DRAWN
  PHOTO
}

// Phase 1.1-1: a signature proof attached to a devis/facture — either drawn
// on-screen by the client or a photographed paper signature, composited
// onto the PDF at render time (see PdfService.buildSignatureBlock). Same
// "keep the payload out of the main row" reasoning as CompanyLogo above.
// Only one signature per document — attaching a new one replaces the old
// (InvoiceService.uploadSignature upserts by invoiceId).
model InvoiceSignature {
  invoiceId String          @id
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  image     Bytes
  // image/png or image/jpeg only, same allow-list/magic-byte validation as
  // CompanyLogo — see common/raster-image-upload.util.ts.
  mimeType  String
  method    SignatureMethod
  createdAt DateTime        @default(now())
}

// Phase 13: one artisan account. Strictly 1:1 with Company (companyId is
// unique) — no multi-user-per-company/team model. passwordHash is nullable
// because a Google-only account never sets one; at least one of
// passwordHash/googleId is always present (enforced in AuthService, not the
// DB, since Prisma has no cross-column CHECK constraint support here).
model User {
  id String @id @default(uuid())

  email        String  @unique
  passwordHash String?
  googleId     String? @unique

  role UserRole @default(ARTISAN)

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // RGPD/legal consent trail — see docs/roadmap.md Phase 13. Newsletter
  // opt-in is deliberately its own unchecked-by-default field, never
  // bundled with the mandatory terms checkbox below.
  newsletterOptIn Boolean  @default(false)
  termsAcceptedAt DateTime
  termsVersion    String

  // Deliberately non-blocking: null just means the reminder banner shows,
  // never a barrier to using the app. Set once by AuthService.verifyEmail().
  emailVerifiedAt DateTime?

  refreshTokens RefreshToken[]
  authTokens    AuthToken[]
  pushDevices   PushDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One rotated refresh-token issuance. The raw token only ever lives in the
// httpOnly cookie handed to the browser — tokenHash (sha256 of it) is what's
// persisted, so a DB leak alone can never be replayed. revokedAt is set both
// on ordinary rotation (AuthService.refresh) and on logout; a refresh
// request presenting an already-revoked token is treated as a stolen/replayed
// token and revokes every row for that user (see AuthService.refresh).
model RefreshToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?

  // Set when this token is revoked *because* it was cleanly rotated forward
  // (see AuthService.rotateFrom) — points at the tokenHash of whatever
  // replaced it. Left null when revoked for any other reason (logout,
  // theft-response nuke-all). AuthService.handleReuse uses "is this set" to
  // tell a benign concurrent-rotation race (two tabs refreshing at once)
  // apart from a genuine replay of a dead token, which only the latter
  // should treat as a stolen refresh token.
  replacedByTokenHash String? @unique

  // Carries the artisan's "rester connecté" choice across rotations — each
  // rotated token in the chain gets the same expiry length as the one it
  // replaces (30 days) or doesn't (1 day), rather than a duration inferred
  // from expiresAt - createdAt, which would be fragile if either constant
  // ever changes.
  remembered Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([userId])
}

// A single-use, expiring, hashed token backing both email verification and
// password reset (see AuthTokenPurpose above) — consumedAt is set the
// moment it's used so it can never be replayed, same "hash at rest, never
// the raw value" posture as RefreshToken.
model AuthToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
}

enum PushPlatform {
  IOS
  ANDROID
}

// One registered mobile-app install for push notifications (Phase 22).
// token is the FCM registration token — both platforms route through FCM
// (iOS bridges via APNs internally through Firebase), so there is only
// ever one token shape to store here. @unique on token, not a composite
// (userId, token) key: the same physical device can only ever hold one
// live token, and re-registering (reinstall, token refresh, or a different
// artisan logging in on the same phone) must overwrite the existing row,
// never accumulate stale duplicates for a device nobody uses anymore.
model PushDevice {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  platform PushPlatform
  token    String       @unique

  lastActiveAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Invoice {
  id String @id @default(uuid())

  // Phase 27: unique per company, not globally — two different artisans
  // both starting from the same default prefix/first-number (e.g. every new
  // company's very first devis) must never collide. See @@unique below.
  number String
  date   DateTime @default(now())

  customerName    String
  customerAddress String?
  customerEmail   String?
  customerPhone   String?
  // Phase 1.1-8 (2026 e-invoicing reform baseline field): same
  // autofill-then-freehand-editable, soft-reference snapshot spirit as the
  // four fields above — autofilled from Customer.siret at pick time (mode
  // rapide only; mode manuel has no customer picker and already covers this
  // via its own freehand InvoiceCustomerField mechanism instead). PdfService
  // prints the SIREN (its first 9 digits) when present.
  customerSiret   String?
  // Autofilled from Customer.address at pick time, same spirit as
  // customerSiret above — but unlike it, also has a dedicated freehand input
  // in mode manuel (see docs/roadmap.md Phase 1.1-8's notes), since its
  // "print only when it differs from customerAddress" rendering rule can't
  // be reproduced by the generic InvoiceCustomerField mechanism. Frozen at
  // pick time, not live-linked to customerAddress afterward — the two are
  // free to diverge from the moment they're set.
  deliveryAddress String?

  // Soft reference to the saved Customer this invoice was based on, if any.
  // The fields above remain the source of truth for this invoice (typed or
  // autofilled-then-edited by the artisan); onDelete: SetNull so deleting a
  // Customer record can never delete or corrupt an already-issued invoice.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Freehand, artisan-named extra client fields (e.g. "SIRET"), manual mode
  // only — no fixed vocabulary, since the whole point is letting the artisan
  // add whatever field the job needs. See InvoiceCustomerField below.
  customerFields InvoiceCustomerField[]

  companyId String
  // Phase 13: onDelete: Cascade so RGPD self-service account deletion
  // (AuthService.deleteAccount -> prisma.company.delete) wipes every issued
  // invoice for that tenant in the same atomic operation, rather than being
  // blocked by the DB's default RESTRICT.
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Snapshotted from Company at creation time so a later change to the
  // artisan's legal status never retroactively changes an issued invoice's
  // tax treatment.
  vatApplicable      Boolean
  vatRateBasisPoints Int

  // Phase 9.5 bis: manual mode's own "nothing is computed behind the
  // artisan's back" principle, extended from the per-row LINE_TOTAL cell up
  // to the invoice's aggregate figures. When set, each overrides the
  // corresponding computed value (row-total sum, rate x subtotal, subtotal +
  // VAT) — see InvoiceMapper.toManualInvoiceWithTotals. Always null for
  // entryMode GUIDED (enforced by ManualModeFieldsConsistency), where totals
  // stay purely derived, never persisted.
  subtotalOverrideCents Int?
  vatOverrideCents      Int?
  totalOverrideCents    Int?

  // Phase 9.5: see InvoiceEntryMode above. GUIDED invoices use lines/
  // serviceLines below; MANUAL invoices use manualColumns/manualRows instead
  // and leave lines/serviceLines empty.
  entryMode InvoiceEntryMode @default(GUIDED)

  // Phase 14.3: which kind of document this row is — see DocumentType above.
  documentType DocumentType @default(FACTURE)

  // Phase 23: artisan-chosen, persisted like showUnitDetail/showBillingDetail
  // below — set from the "Personnaliser l'affichage" screen, hides the whole
  // Quantité/Prix unitaire columns on the generated PDF, leaving only
  // description + line total. Purely a rendering concern, document-level
  // (unlike the two per-line toggles below). Defaults false so an artisan
  // who never opens that screen sees no behavior change.
  simplifiedDisplay Boolean @default(false)

  // Set on a FACTURE created by converting a DEVIS — points at the original
  // devis, which conversion leaves untouched and independently retrievable
  // (a new Invoice row is created, never a mutation in place). @unique
  // since a devis converts into at most one facture; onDelete: SetNull so
  // deleting either side never cascades into the other, same soft-reference
  // spirit as customerId above.
  convertedFromDevisId String?  @unique
  convertedFromDevis   Invoice? @relation("DevisConversion", fields: [convertedFromDevisId], references: [id], onDelete: SetNull)
  convertedToFacture   Invoice? @relation("DevisConversion")

  // Set on a DEVIS created retroactively from an existing FACTURE (the
  // artisan forgot to make the devis first) — points at the source
  // facture, which this leaves untouched (a new Invoice row is created,
  // never a mutation in place). @unique since a facture can spawn at most
  // one retroactive devis; onDelete: SetNull, same soft-reference spirit
  // as convertedFromDevisId above.
  createdFromFactureId String?  @unique
  createdFromFacture   Invoice? @relation("FactureRetroConversion", fields: [createdFromFactureId], references: [id], onDelete: SetNull)
  retroactiveDevis     Invoice? @relation("FactureRetroConversion")

  lines         InvoiceLine[]
  serviceLines  InvoiceServiceLine[]
  discountLines InvoiceDiscountLine[]

  manualColumns ManualInvoiceColumn[]
  manualRows    ManualInvoiceRow[]

  // Phase 12 invoice mailing: last successful send only — not a log table.
  // sentAt null means never sent; a later send simply overwrites both, since
  // "has this ever reached the client" is the only thing the UI needs (see
  // docs/roadmap.md Phase 12).
  sentAt      DateTime?
  sentToEmail String?

  // Phase 16: see InvoiceStatus above. Never touched for a DEVIS.
  status InvoiceStatus @default(NON_PAYEE)

  // The date the client committed to paying by — captured lazily, the
  // first time it's actually needed (board's drop-into-"Non payées" modal),
  // not at invoice creation. Optional and editable later from the card.
  dueDate DateTime?

  // Set when status becomes PAYEE, cleared if moved back out — records the
  // fact, not a log, same single-field convention as sentAt above.
  paidAt DateTime?

  // Bumped every time a mail is sent while the invoice is still NON_PAYEE
  // (see InvoiceMailService.send) — same "was this ever done, and when most
  // recently" convention as sentAt/sentToEmail, not a history table.
  lastReminderAt DateTime?

  // Bumped by ReminderCronService's daily digest push (Phase 22) — kept
  // separate from lastReminderAt above on purpose: that field means "we
  // emailed the *client*" (artisan-triggered "renvoyer un mail"), while this
  // one means "the *artisan* was already push-notified about this invoice
  // today" (system-triggered). Conflating them would change lastReminderAt's
  // existing meaning for the one call site that already reads it. Only
  // guards against double-notifying if the cron is ever manually re-run
  // within the same day.
  lastPushReminderAt DateTime?

  // Phase 1.1-1: the freehand fallback the "signed" checkbox falls back to
  // when no InvoiceSignature exists below — only interactive while that's
  // the case (see InvoiceService.setManuallySigned); attaching a real
  // signature locks the checkbox checked and stops this from being toggled.
  manuallySigned Boolean           @default(false)
  signature      InvoiceSignature?

  // Phase 1.1-3: the requested deposit, snapshotted at creation the same way
  // vatApplicable/vatRateBasisPoints are — both null means no deposit was
  // requested, both set together (enforced by DepositFieldsConsistency at
  // the DTO boundary, not the DB), FACTURE-only (same scope as
  // vatApplicable's FACTURE/DEVIS-agnostic snapshot, but this one is never
  // set on a DEVIS — a quote isn't something a client pays a deposit
  // against yet). depositPercentageBasisPoints is basis points against the
  // invoice's own Total TTC (same convention as vatRateBasisPoints);
  // depositAmountCents is the resolved euro amount, freehand-editable
  // independent of the percentage once the artisan types over it directly
  // (see InvoiceDraftStore/ManualInvoiceDraftStore's autoCalc — the two can
  // legitimately disagree once decoupled, same "resolved once, not a live
  // formula" spirit as InvoiceDiscountLine, just keeping both figures since
  // the PDF prints them together: "Acompte demandé : 30 % soit 450,00 €").
  depositPercentageBasisPoints Int?
  depositAmountCents           Int?
  // Set when the board status moves into ACOMPTE_VERSE, cleared if moved
  // back out — same "records the fact, not a log" convention as paidAt.
  depositPaidAt                DateTime?

  // Phase 1.1-7: "Autoliquidation (sous-traitance BTP)" — art. 242 nonies A,
  // 13° de l'annexe II au CGI. FACTURE-only, per-document (enforced at the
  // DTO boundary, not the DB — same pattern as depositAmountCents above):
  // whether a given job is subcontracted work depends on that specific
  // chantier, never a fixed company-wide fact, and a DEVIS is a quote, not
  // yet a billable subcontracting relationship. When set, InvoiceService
  // forces vatApplicable false the same way franchise en base does (see
  // isVatApplicable/vatApplicableOverride), but PdfService.buildFooter
  // prints the distinct autoliquidation citation instead of art. 293 B's —
  // this flag, not vatApplicable alone, is what tells buildFooter which of
  // the two citations is legally accurate for this document.
  reverseChargeApplicable Boolean @default(false)

  // Phase 1.1-8: entryMode MANUAL's own explicit "nature de l'opération"
  // choice — see NatureOperation's own comment for why GUIDED never uses
  // this column (derived instead). Always null for GUIDED, enforced by
  // ManualModeFieldsConsistency; defaults to PRESTATION_SERVICES at the
  // service layer when omitted for MANUAL (InvoiceService.create), so this
  // column itself stays nullable rather than needing a Prisma-level default
  // that would be wrong for every GUIDED row.
  manualNatureOfOperation NatureOperation?

  // Phase 1.2-4 (2026 e-invoicing reform): transmission through the
  // connected PA (SUPER PDP) — FACTURE-only in practice (InvoiceController
  // gates the transmit endpoint the same way it already gates
  // downloadFacturX), but left ungated at the schema level like every other
  // FACTURE-only column here (compare status/dueDate). eInvoiceRejection
  // Reason is the PA's own human-readable explanation, surfaced to the
  // artisan verbatim rather than a generic "failed" message (Phase 10/12/17's
  // established honesty principle) — see e-invoicing/electronic-invoicing-
  // provider.interface.ts.
  eInvoiceTransmissionStatus EInvoiceTransmissionStatus @default(NOT_SENT)
  eInvoiceTransmittedAt      DateTime?
  eInvoiceRejectionReason    String?
  // The PA's own tracking id for this invoice — opaque to the rest of the
  // app, only ever passed back to the same provider to poll status.
  superPdpInvoiceId          String?

  // Phase 1.3-3 (2026 e-invoicing reform, workflow automation): set at
  // creation only when Company.autoTransmitViaPa was on and SUPER PDP was
  // connected at that moment — null means "not queued" (manual mode, a
  // DEVIS, or already past its grace period). transmitCancelledAt is set if
  // the artisan cancels a still-pending auto-transmission from the invoice
  // board; AutoTransmitCronService's sweep skips any row where it's set.
  // Both are DB-persisted (not an in-memory timer) specifically so a
  // pending auto-transmission survives a backend restart mid-grace-period.
  scheduledTransmitAt DateTime?
  transmitCancelledAt DateTime?

  // Phase 1.3-7: "Partager" — a random, unguessable, opaque token (never the
  // invoice's own id) that lets whoever holds the link view/download this
  // one document without a session, via a @Public() route keyed on the
  // token instead of companyId. Null until first requested (lazily
  // generated — see InvoiceRepository.getOrCreateShareToken), and there is
  // deliberately no expiry column: the artisan revokes by clearing it
  // (InvoiceRepository.revokeShareToken), not by waiting one out — see the
  // roadmap's own note on why (a facture a client needs for their own
  // accounting years later shouldn't silently stop working).
  shareToken String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@index([customerId])
  // Cross-tenant sweep for ReminderCronService (Phase 22) — unlike every
  // other index on this table, this one isn't scoped to a single company:
  // the daily job scans NON_PAYEE invoices by dueDate across all artisans.
  @@index([status, dueDate])
  // Cross-tenant sweep for AutoTransmitCronService (Phase 1.3-3), same
  // "not scoped to one company" reasoning as the index above.
  @@index([scheduledTransmitAt])
}

// A freehand extra client field on a manual-mode invoice (e.g. "SIRET" ->
// "123 456 789 00012") — no fixed vocabulary, unlike customerName/Address/
// Email/Phone above: the artisan names the field themselves. Same snapshot
// spirit as the rest of Invoice's customer fields, never tied to a live
// Customer row.
model InvoiceCustomerField {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position  Int

  label String
  value String

  @@index([invoiceId])
}

model Customer {
  id String @id @default(uuid())

  name        String
  companyName String?
  address     String?
  email       String?
  phone       String?
  siret       String?

  // Phase 1.1-7: the artisan's own declaration that this client is a
  // professional (buying for their own business), not an individual
  // consumer — same "own declaration, never reliably inferable" spirit as
  // Company.decennialInsuranceApplicable. companyName/siret filled in is a
  // *hint* the frontend pre-checks this from, but never a lock: a
  // sole-trader client with no siret on file is still legally
  // "professionnel" if they're buying for their business, and this stays
  // independently overridable either way. Drives whether PdfService.buildFooter
  // prints the Art. L441-9 payment-terms mentions on a FACTURE (resolved
  // live from this field at PDF-render time, never snapshotted onto
  // Invoice — same "always live off current state" precedent as
  // Company.decennialInsurerName/customFooterMessage).
  isProfessional Boolean @default(false)

  // Phase 14.5: freehand, optional — same "autofill, not a lock" spirit as
  // every other optional field here. Feeds customer search alongside name/
  // companyName/address (see CustomerRepository.findAll).
  description String?

  // Phase 13: every catalog/customer row belongs to exactly one tenant.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

// Phase 1.1-2: an artisan-created, type-agnostic grouping an item can
// optionally belong to (e.g. "Plomberie") — see CatalogFolder below.
model CatalogFolder {
  id String @id @default(uuid())

  name String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // Phase 1.1-2: implicit many-to-many, one join table per pair — Prisma has
  // no single polymorphic m2m across three models, and a folder is a
  // type-agnostic list (one folder can hold products, services, and
  // discounts alike, since a trade isn't just one catalog type). Deleting
  // this folder just drops its join rows; an item with no folders left
  // simply falls back to the unassigned list.
  products  Product[]
  services  Service[]
  discounts Discount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model Product {
  id String @id @default(uuid())

  name         String
  description  String?
  unit         Unit
  priceCents   Int
  supplierName String?
  supplierUrl  String?

  // Phase 11: a short artisan-defined reference (SKU-like, e.g. "UC204850"),
  // the way professional trades already identify catalog items — makes
  // searching/scanning a large catalog faster than by name alone. Optional
  // and freely editable; unique per-tenant (see @@unique below), not
  // globally, since Phase 13 gives every artisan their own catalog.
  code String?

  // Phase 8.5: how many `unit`s come in one sellable package (e.g. 9 for a
  // 9 m² box of flooring). Null means the product is sold continuously
  // (today's behavior, unchanged) — this is what lets an invoice line
  // compute how many whole packages a job actually needs instead of
  // conflating the site's raw measurement with what gets billed. See
  // docs/roadmap.md Phase 8.5 and InvoiceLine.packagingQuantity below.
  packagingQuantity Decimal? @db.Decimal(10, 3)

  // Phase 17: which URSSAF turnover category this product's sales fall
  // under — see ActivityCategory above. Optional; left unset, an invoice
  // line built from this product reports as "non catégorisé".
  activityCategory ActivityCategory?

  // Phase 13: every catalog row belongs to exactly one tenant.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceLines InvoiceLine[]

  // Phase 1.1-2: zero, one, or several dossiers this product belongs to —
  // see CatalogFolder above.
  folders CatalogFolder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

// Phase 5 catalog entry for non-material work (labor, expertise, misc
// charges) — same shape as Product minus the supplier fields, plus a
// default visibility mode that prefills (never locks) the invoice
// service-line form.
model Service {
  id String @id @default(uuid())

  name        String
  description String?

  // Phase 13.5: pricingMode picks which of the two below is meaningful.
  // priceCents is nullable now (was required pre-Phase-13.5) since a
  // PERCENTAGE-mode service has none; percentageBasisPoints is the mirror
  // image, only meaningful for PERCENTAGE (3000 = 30.00%, same convention as
  // Company.vatRateBasisPoints). Computing an invoice line's actual amount
  // from a PERCENTAGE service happens client-side, at line-activation time —
  // see docs/roadmap.md Phase 13.5's implementation notes for why this
  // doesn't need a backend/InvoiceServiceLine change: the resulting
  // amountCents is submitted like any other service line, same "autofill,
  // not a lock" snapshot as every other catalog reference in this app.
  pricingMode           ServicePricingMode @default(FIXED)
  priceCents            Int?
  percentageBasisPoints Int?
  defaultVisibility     ServiceVisibility  @default(VISIBLE)

  // Phase 17: same URSSAF turnover categorization as Product.activityCategory
  // above, for this service's own sales.
  activityCategory ActivityCategory?

  // Phase 11: same short artisan-defined reference as Product.code — makes
  // searching/scanning a large service catalog faster than by name alone.
  // Optional and freely editable; unique per-tenant (see @@unique below),
  // not globally, same Phase 13 change as Product.code.
  code String?

  // Phase 13: every catalog row belongs to exactly one tenant.
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceServiceLines InvoiceServiceLine[]

  // Phase 1.1-2: zero, one, or several dossiers this service belongs to —
  // see CatalogFolder above.
  folders CatalogFolder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

// Phase 32: catalog entry for a reusable named discount/remise — the quick
// mode's third button, alongside Product/Service. Deliberately a shorter
// shape than Product/Service (no code/description/activityCategory): name +
// type + value only, matching the artisan-facing form. See DiscountType
// above for what fixedAmountCents/percentageBasisPoints mean and why only
// InvoiceDiscountLine's already-resolved amountCents (never a rate) is
// persisted once a discount is actually applied to an invoice.
model Discount {
  id String @id @default(uuid())

  name String

  discountType          DiscountType @default(FIXED)
  fixedAmountCents      Int?
  percentageBasisPoints Int?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceDiscountLines InvoiceDiscountLine[]

  // Phase 1.1-2: zero, one, or several dossiers this discount belongs to —
  // see CatalogFolder above.
  folders CatalogFolder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model InvoiceLine {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position  Int

  description String
  // The calculation mode (area-with-waste-surcharge vs. plain quantity) is
  // derived from this unit's semantics (isAreaUnit()), never stored
  // separately — see docs/roadmap.md Phase 7 and unit.util.ts.
  unit        Unit

  quantity       Decimal        @db.Decimal(10, 3)
  unitPriceCents Int
  wasteSurcharge WasteSurcharge @default(NONE)

  // Phase 8.5 — snapshotted/freehand, same "autofill, not a lock" rule as
  // every other soft catalog reference here: never re-read from Product
  // after the line is created. `quantity` above stays the artisan's raw
  // site/job measurement ("site quantity"); packagingQuantity is how many
  // `unit`s come in one sellable package (e.g. 9 for a 9 m² box).
  // roundUpToPackaging controls whether the billed quantity is rounded up
  // to the next whole package — defaults to true (automated calculation is
  // the default, manual exact-quantity billing is the artisan's opt-out)
  // and is simply inert when packagingQuantity is null. See
  // InvoiceCalculationService.computeLineTotal for where this is applied.
  packagingQuantity  Decimal? @db.Decimal(10, 3)
  roundUpToPackaging Boolean  @default(true)

  // Freehand product reference for this line (e.g. "UC204850") — same
  // snapshot/soft-reference spirit as packagingQuantity above: never tied to
  // a live Product row, just jotted text the artisan can carry over even
  // for an ad-hoc line that isn't saved to the catalog.
  productCode String?

  // Soft reference to the saved Product this line was toggled on from, if
  // any — same "autofill, not a lock" rule as InvoiceServiceLine.serviceId
  // (onDelete: SetNull so deleting a Product can never corrupt an
  // already-issued invoice). Only set for a catalog-picked line, never a
  // freehand one; lets "Mes produits" jump to the invoices that used a given
  // product the same way "Mes clients" already does for a customer.
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Phase 15 — artisan-chosen, persisted like the vatApplicable snapshot
  // (not derived): whether this line's technical detail renders on the
  // generated PDF. showUnitDetail governs the "Unité" cell; showBillingDetail
  // governs the "(facturé : X)" clarifying note (waste surcharge/packaging
  // rounding). Purely a rendering concern — never affects computeLineTotal.
  // Both default true so an artisan who never touches Phase 15's preview
  // toggles sees no behavior change.
  showUnitDetail    Boolean @default(true)
  showBillingDetail Boolean @default(true)

  // Phase 17: snapshotted from the picked Product.activityCategory at
  // creation time (or left null for a freehand line/an uncategorized
  // product) — never re-read from Product afterwards, same "autofill, not a
  // lock" spirit as productCode above. Deliberately a snapshot rather than a
  // live join through productCode: recategorizing a catalog product later
  // must never retroactively change a quarterly report for a period already
  // declared to URSSAF. See docs/roadmap.md Phase 17.
  activityCategory ActivityCategory?

  serviceWeights InvoiceServiceLineWeight[]

  // Phase 34: reverse side of InvoiceDiscountLine.targetInvoiceLine — the
  // remise(s) scoped to this line, if any. Never read to compute this line's
  // own total (see InvoiceDiscountLine's comment); only exists so Prisma's
  // relation is bidirectional.
  targetedByDiscountLines InvoiceDiscountLine[] @relation("DiscountTargetLine")

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// A service added to an invoice (Phase 5): either its own visible line
// (`visibility: VISIBLE`, rendered separately from product lines — see
// architecture.md) or a hidden amount redistributed into the invoice's other
// lines (`visibility: REDISTRIBUTED`, via `weights` below). `amountCents` is
// always the source of truth for this invoice, same snapshot spirit as
// Invoice.customerName — never re-read from `service` after creation.
model InvoiceServiceLine {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position  Int

  // Soft reference to a saved Service, if any — "autofill, not a lock" rule
  // (see conventions.md), onDelete: SetNull so deleting a Service can never
  // corrupt an already-issued invoice.
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  name        String
  description String?
  amountCents Int
  visibility  ServiceVisibility

  // Phase 17: same snapshot rule as InvoiceLine.activityCategory above,
  // taken from Service.activityCategory when serviceId is set (null for a
  // freehand service line). REDISTRIBUTED amounts folded into product lines
  // (see InvoiceMapper) are bucketed under those lines' own
  // activityCategory instead — this field only matters for VISIBLE lines.
  activityCategory ActivityCategory?

  // Only populated when visibility = REDISTRIBUTED. An EQUAL split is
  // stored as a weight of 1 on every invoice line at creation time — there
  // is no separate "strategy" column, weighted distribution is the only
  // math the read path needs (see InvoiceCalculationService.computeWeightedSplit).
  weights InvoiceServiceLineWeight[]

  // Phase 34: reverse side of InvoiceDiscountLine.targetInvoiceServiceLine —
  // same "exists only for Prisma's bidirectional relation" role as
  // InvoiceLine.targetedByDiscountLines above.
  targetedByDiscountLines InvoiceDiscountLine[] @relation("DiscountTargetServiceLine")

  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// Phase 32: a remise applied to an invoice/devis (GUIDED mode only — see
// ManualModeFieldsConsistency, which forbids this for MANUAL) — always folds
// its resolved amountCents straight into the subtotal as a reduction, no
// visibility/redistribution concept (unlike InvoiceServiceLine, it never
// splits its amount across several lines — see the two soft target
// references below for the one-line-or-none it can still be scoped to).
// Soft reference to a saved Discount, same "autofill, not a lock" rule as
// InvoiceServiceLine.serviceId — amountCents is always the source of truth
// for this invoice, never re-read from `discount` after creation, and (same
// as a PERCENTAGE service line) the original discountType/rate is not
// retained once persisted.
model InvoiceDiscountLine {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position  Int

  discountId String?
  discount   Discount? @relation(fields: [discountId], references: [id], onDelete: SetNull)

  name        String
  amountCents Int

  // Phase 34: which single product/service line (already added to the same
  // invoice) this remise is scoped to, if any — mutually exclusive (enforced
  // by DiscountTargetMatchesLines at the DTO boundary, not the DB), both null
  // for a remise on the invoice's general total (the pre-Phase-34 default
  // behavior). Purely informational/percentage-base metadata: a targeted
  // remise still folds its amountCents into the invoice subtotal exactly
  // like an untargeted one (see InvoiceMapper) — it never changes
  // targetInvoiceLine/targetInvoiceServiceLine's own displayed total. Soft
  // references, same "autofill, not a lock" rule as discountId above —
  // onDelete: SetNull so removing the targeted line (impossible today, no
  // per-line delete endpoint, but the invoice itself cascades) can never
  // corrupt this row.
  targetInvoiceLineId String?
  targetInvoiceLine   InvoiceLine? @relation("DiscountTargetLine", fields: [targetInvoiceLineId], references: [id], onDelete: SetNull)

  targetInvoiceServiceLineId String?
  targetInvoiceServiceLine   InvoiceServiceLine? @relation("DiscountTargetServiceLine", fields: [targetInvoiceServiceLineId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([targetInvoiceLineId])
  @@index([targetInvoiceServiceLineId])
}

// Phase 9.5 manual mode: one column of the free-form invoice canvas — see
// ManualColumnRole above for what each role means for pricing.
model ManualInvoiceColumn {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position  Int

  role  ManualColumnRole
  label String

  // Persisted resize state (px) from dragging the column's edge on the
  // canvas — purely presentational, never affects calculation.
  widthPx Int?

  cells ManualInvoiceCell[]

  @@index([invoiceId])
}

// One row of the manual canvas = one priced line item, the same conceptual
// unit as a GUIDED InvoiceLine.
model ManualInvoiceRow {
  id String @id @default(uuid())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position  Int

  // Persisted resize state (px) from dragging the row's edge on the canvas —
  // purely presentational, never affects calculation.
  heightPx Int?

  cells ManualInvoiceCell[]

  @@index([invoiceId])
}

// One cell's raw text, exactly as the artisan typed it. Always plain text,
// never markup: the canvas edits through real <input>/<textarea> elements,
// which never interpret pasted content as HTML, so there is no injection
// surface here to sanitize against (see docs/roadmap.md Phase 9.5's security
// note — this is why no DOMPurify-style step exists in this pipeline).
model ManualInvoiceCell {
  id String @id @default(uuid())

  rowId String
  row   ManualInvoiceRow @relation(fields: [rowId], references: [id], onDelete: Cascade)

  columnId String
  column   ManualInvoiceColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)

  value String

  @@unique([rowId, columnId])
  @@index([rowId])
  @@index([columnId])
}

// One artisan-set weight of a REDISTRIBUTED service line's amount onto one
// invoice line. The actual redistributed cents are never persisted — only
// the weight is; the split itself is recomputed on every read, same
// "derived data is never persisted" rule as invoice totals.
model InvoiceServiceLineWeight {
  id String @id @default(uuid())

  invoiceServiceLineId String
  invoiceServiceLine   InvoiceServiceLine @relation(fields: [invoiceServiceLineId], references: [id], onDelete: Cascade)

  invoiceLineId String
  invoiceLine   InvoiceLine @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)

  weight Int

  @@unique([invoiceServiceLineId, invoiceLineId])
}

// Phase 10: cached result of one AI sourcing call (supplier search or
// complementary-material suggestions). Doubles as both the cache ("reopening
// a line doesn't re-trigger a live search") and the daily-cap log (counting
// rows created today per company IS counting real Groq calls made today,
// since a cache hit never inserts a new row) — one table serves both jobs,
// see SourcingRepository.
model SourcingSearch {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind SourcingSearchKind

  // Stable hash of the normalized query params (product name, quantity,
  // unit, city, job date / product name+category) — never the raw params
  // themselves, so this stays one short indexed column regardless of kind.
  queryHash String

  // The validated, already-shaped response (candidates or suggestions) —
  // see sourcing/entities/*.ts for the shape stored here per kind. Never
  // the model's raw text: SourcingService only ever persists output that
  // has already passed groq-response.util.ts's validation.
  resultJson Json

  createdAt DateTime @default(now())

  @@unique([companyId, kind, queryHash])
  @@index([companyId, createdAt])
}

// Phase 14: an admin-issued code redeemable once per company for a fixed
// number of days of premium access (e.g. a "premium 1 month" code handed
// out for support/marketing purposes) — a lighter-weight path than Stripe
// checkout for granting access without payment. code is stored uppercased
// (see PromoCodeService.normalizeCode) so redemption is case-insensitive
// without a citext extension. redemptionsCount is a denormalized counter
// (incremented in the same transaction as each PromoCodeRedemption insert)
// so "is this code exhausted" is a cheap read on the row itself instead of
// a COUNT(*) over redemptions on every redemption attempt.
model PromoCode {
  id String @id @default(uuid())

  code             String    @unique
  // Phase 30: which tier this code grants — defaults every pre-existing
  // code to PREMIUM (their only possible meaning before tiers existed), so
  // a code issued before this phase keeps granting exactly what it always
  // granted.
  planTier         PlanTier  @default(PREMIUM)
  durationDays     Int
  maxRedemptions   Int?
  redemptionsCount Int       @default(0)
  active           Boolean   @default(true)
  expiresAt        DateTime?

  redemptions PromoCodeRedemption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per (code, company) redemption — the @@unique below is what
// actually enforces "once per account" at the DB level, not just app-side
// logic that a race could slip past.
model PromoCodeRedemption {
  id String @id @default(uuid())

  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  redeemedAt DateTime @default(now())

  @@unique([promoCodeId, companyId])
  @@index([companyId])
}

// Phase 29: one row per referred company, created at registration time
// (referredCompanyId is @@unique — a company can be referred at most once,
// immutable after). rewardGrantedAt stays null until AuthService.verifyEmail
// actually grants the 30-day reward to both companies — deliberately not
// granted at registration itself, since an unverified email is trivially
// fakeable in bulk (see docs/roadmap.md Phase 29's anti-abuse section).
model Referral {
  id String @id @default(uuid())

  referrerCompanyId String
  referrerCompany   Company @relation("Referrer", fields: [referrerCompanyId], references: [id], onDelete: Cascade)

  referredCompanyId String  @unique
  referredCompany   Company @relation("Referred", fields: [referredCompanyId], references: [id], onDelete: Cascade)

  rewardGrantedAt   DateTime?
  // Phase 30: the actual number of Premium days granted to the parrain for
  // this specific referral — varies with the parrain's own plan tier at
  // the moment the reward fired (see REFERRAL_PARRAIN_REWARD_DAYS_BY_TIER),
  // so it has to be recorded per-row rather than recomputed from a single
  // flat constant. Null until rewardGrantedAt is set.
  rewardDaysGranted Int?

  createdAt DateTime @default(now())

  @@index([referrerCompanyId])
}

// Phase 20: FactureLe's own legal identity as the SaaS publisher (mentions
// légales) — distinct from Company above, which is per-tenant data an
// artisan enters for their own invoices and can't be reused here. Single
// row, fixed id (SITE_LEGAL_INFO_ID in site-legal.repository.ts), upserted
// from the admin dashboard so this is editable in exactly one place without
// a migration or hunting across pages for hardcoded copies. Every field
// starts empty on a fresh deploy — deliberately not seeded with placeholder
// text, since fabricating a SIRET/address would be actively wrong; the
// admin "Infos légales" page must be filled in with real values before
// launch.
model SiteLegalInfo {
  id String @id @default("singleton")

  publisherName          String @default("")
  siret                  String @default("")
  address                String @default("")
  directorOfPublication  String @default("")
  hostingProviderName    String @default("")
  hostingProviderAddress String @default("")
  contactEmail           String @default("")

  updatedAt DateTime @updatedAt
}
