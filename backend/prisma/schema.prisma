generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LegalStatus {
  MICRO_ENTREPRENEUR
  COMPANY
}

enum LineMode {
  AREA
  UNIT
}

enum WasteSurcharge {
  NONE
  TEN
  TWENTY
}

enum ServiceVisibility {
  VISIBLE
  REDISTRIBUTED
}

model Company {
  id                  String      @id @default(uuid())

  name                String
  siret               String
  addressLine1        String
  addressLine2        String?
  postalCode          String
  city                String
  email               String?
  phone               String?

  legalStatus         LegalStatus
  vatRateBasisPoints  Int         @default(2000)

  invoiceNumberPrefix String      @default("F")
  nextInvoiceNumber   Int         @default(1)

  invoices            Invoice[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model Invoice {
  id                 String        @id @default(uuid())

  number             String        @unique
  date               DateTime      @default(now())

  customerName       String
  customerAddress    String?
  customerEmail      String?
  customerPhone      String?

  // Soft reference to the saved Customer this invoice was based on, if any.
  // The fields above remain the source of truth for this invoice (typed or
  // autofilled-then-edited by the artisan); onDelete: SetNull so deleting a
  // Customer record can never delete or corrupt an already-issued invoice.
  customerId         String?
  customer           Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)

  companyId          String
  company            Company       @relation(fields: [companyId], references: [id])

  // Snapshotted from Company at creation time so a later change to the
  // artisan's legal status never retroactively changes an issued invoice's
  // tax treatment.
  vatApplicable      Boolean
  vatRateBasisPoints Int

  lines              InvoiceLine[]
  serviceLines       InvoiceServiceLine[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([companyId])
  @@index([customerId])
}

model Customer {
  id          String    @id @default(uuid())

  name        String
  companyName String?
  address     String?
  email       String?
  phone       String?
  siret       String?

  invoices    Invoice[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id           String   @id @default(uuid())

  name         String
  description  String?
  unit         String
  priceCents   Int
  supplierName String?
  supplierUrl  String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Phase 5 catalog entry for non-material work (labor, expertise, misc
// charges) — same shape as Product minus the supplier fields, plus a
// default visibility mode that prefills (never locks) the invoice
// service-line form.
model Service {
  id                String            @id @default(uuid())

  name              String
  description       String?
  priceCents        Int
  defaultVisibility ServiceVisibility @default(VISIBLE)

  invoiceServiceLines InvoiceServiceLine[]

  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model InvoiceLine {
  id             String         @id @default(uuid())

  invoiceId      String
  invoice        Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int

  description    String
  unit           String

  mode           LineMode
  quantity       Decimal        @db.Decimal(10, 3)
  unitPriceCents Int
  wasteSurcharge WasteSurcharge @default(NONE)

  serviceWeights InvoiceServiceLineWeight[]

  createdAt      DateTime       @default(now())

  @@index([invoiceId])
}

// A service added to an invoice (Phase 5): either its own visible line
// (`visibility: VISIBLE`, rendered separately from product lines — see
// architecture.md) or a hidden amount redistributed into the invoice's other
// lines (`visibility: REDISTRIBUTED`, via `weights` below). `amountCents` is
// always the source of truth for this invoice, same snapshot spirit as
// Invoice.customerName — never re-read from `service` after creation.
model InvoiceServiceLine {
  id             String            @id @default(uuid())

  invoiceId      String
  invoice        Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int

  // Soft reference to a saved Service, if any — "autofill, not a lock" rule
  // (see conventions.md), onDelete: SetNull so deleting a Service can never
  // corrupt an already-issued invoice.
  serviceId      String?
  service        Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  name           String
  description    String?
  amountCents    Int
  visibility     ServiceVisibility

  // Only populated when visibility = REDISTRIBUTED. An EQUAL split is
  // stored as a weight of 1 on every invoice line at creation time — there
  // is no separate "strategy" column, weighted distribution is the only
  // math the read path needs (see InvoiceCalculationService.computeWeightedSplit).
  weights        InvoiceServiceLineWeight[]

  createdAt      DateTime          @default(now())

  @@index([invoiceId])
}

// One artisan-set weight of a REDISTRIBUTED service line's amount onto one
// invoice line. The actual redistributed cents are never persisted — only
// the weight is; the split itself is recomputed on every read, same
// "derived data is never persisted" rule as invoice totals.
model InvoiceServiceLineWeight {
  id                   String             @id @default(uuid())

  invoiceServiceLineId String
  invoiceServiceLine   InvoiceServiceLine @relation(fields: [invoiceServiceLineId], references: [id], onDelete: Cascade)

  invoiceLineId        String
  invoiceLine          InvoiceLine        @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)

  weight               Int

  @@unique([invoiceServiceLineId, invoiceLineId])
}
