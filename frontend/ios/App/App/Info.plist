<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>FactureLe</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<!-- social-login-parity: native Google Sign-In's browser-based callback
	needs this reversed-client-id URL scheme registered so iOS can hand
	control back to the app after the consent screen. Value is the
	REVERSED_CLIENT_ID from ios/App/App/GoogleService-Info.plist (its
	CLIENT_ID's segments in reverse: com.googleusercontent.apps.<numeric>-<hash>) —
	update this if that plist is ever regenerated with a different client. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
	<string>com.googleusercontent.apps.211973026193-kkifvinno7u9ojc1jfkeg33khvsdt3ss</string>
			</array>
		</dict>
	</array>
	<!-- Phase 22: this app only uses standard HTTPS/TLS (exempt encryption)
	— never a custom cryptographic implementation — so this is answered
	once here instead of App Store Connect asking on every single build
	upload ("Does your app use encryption?"). -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- @capgo/capacitor-social-login's Package.swift declares FacebookCore/
	FacebookLogin unconditionally (SocialLoginPlugin's own dependency list),
	so the Facebook SDK ships inside the binary even though
	capacitor.config.ts's providers.facebook stays false and no Facebook
	login is ever offered — these two keys stop that unused SDK from
	auto-logging app events/collecting the advertising identifier on its
	own, which would otherwise contradict the App Privacy answers (this app
	does no tracking) without any code of ours ever calling into it. -->
	<key>FacebookAutoLogAppEventsEnabled</key>
	<false/>
	<key>FacebookAdvertiserIDCollectionEnabled</key>
	<false/>
	<!-- Phase 1.4-3: required by @capgo/capacitor-speech-recognition
	(SFSpeechRecognizer/SpeechAnalyzer + AVAudioSession) — shown once by
	iOS the first time InvoiceCreateVoiceCapturePage's native path calls
	requestPermissions(), before any audio is captured. Both keys are
	mandatory: iOS refuses to show the permission prompt at all (silent
	failure) if either is missing, rather than falling back to one. -->
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Utilisé pour transcrire ce que vous dictez lors de la création d’une facture ou d’un devis par commande vocale.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Le micro est utilisé pour dicter le contenu d’une facture ou d’un devis.</string>
	<!-- Phase 22: lets a push notification wake the app in the background
	to update local state before the user taps it — required alongside the
	"Background Modes" capability toggle in Xcode's Signing & Capabilities
	tab (that toggle keeps this key in sync; safe to leave here either way). -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- Phase 22 local dev only: capacitor.config.ts's CAPACITOR_LOCAL_HOST
	override points the WebView at a plain-http LAN address for simulator
	testing against a local backend, which iOS's App Transport Security
	blocks by default. Uncomment and fill in the same LAN IP if testing that
	way — remove again before any store submission. -->
	<!--
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>REPLACE_WITH_CAPACITOR_LOCAL_HOST</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	-->
</dict>
</plist>
