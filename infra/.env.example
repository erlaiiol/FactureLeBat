POSTGRES_USER=facturele
# Dev-only default. In infra/.env on a real server, use a strong, unique
# password — never this one (see docs/deployment.md).
POSTGRES_PASSWORD=facturele
POSTGRES_DB=facturele
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=4200

CORS_ORIGIN=http://localhost:4200

# infra/docker-compose.prod.yml only (Caddy edge). Leave as `:80` for local
# `make prod` smoke-testing (plain HTTP, no cert requested). On the real OVH
# deployment, set this to the domain's A record, e.g. facturele.example.com
# — Caddy then requests/renews its Let's Encrypt certificate automatically.
# See docs/deployment.md.
DOMAIN=:80

# infra/docker-compose.prod.yml's backend service loads this whole file via
# env_file, so this is also where every backend/.env.example var lives for
# prod — nothing else touches this container's environment. On the real
# deployment, generate fresh secrets below rather than reusing the
# infra/.env.example defaults (see docs/deployment.md's Secrets section).

# Phase 13 auth — required, prod will not boot without it. Generate one
# with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=
# On the real deployment this should be the public HTTPS origin (the DOMAIN
# above, with scheme), e.g. https://facturele.example.com — used to
# build the links in verification/password-reset emails and the
# post-Google-login redirect.
FRONTEND_URL=http://localhost

# All optional — defaults shown.
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN_DAYS=30
# JWT_REFRESH_NOT_REMEMBERED_EXPIRES_IN_DAYS=1

# Phase 10 sourcing assistant. Leave GROQ_API_KEY unset to run prod with the
# feature disabled (POST /sourcing/* replies 503) — everything else works
# normally without it. Get a free key at https://console.groq.com.
# GROQ_API_KEY=<get-a-free-key-at-console.groq.com>
# SOURCING_DAILY_SEARCH_CAP=20

# Phase 12 invoice mailing — encrypts the artisan's SMTP app password at
# rest. Leave unset to run prod with the feature disabled (PATCH
# /mail-settings and POST /invoices/:id/send-email reply 503). Has no
# rotation path once artisans have mail settings configured (see
# docs/deployment.md) — generate it once with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_ENCRYPTION_KEY=

# Phase 13 Google OAuth. Leave both unset to run prod with Google login
# disabled (GET /auth/google* replies 503) — email/password auth still
# works normally without it. Create credentials at
# https://console.cloud.google.com/apis/credentials, with the callback URL
# below registered as an authorized redirect URI.
# GOOGLE_CLIENT_ID=<create-oauth-credentials-at-console.cloud.google.com>
# GOOGLE_CLIENT_SECRET=<create-oauth-credentials-at-console.cloud.google.com>
# GOOGLE_CALLBACK_URL=https://facturele.example.com/api/auth/google/callback

# Phase 13 transactional email (account verification, password reset) — the
# app's own system mailbox, deliberately separate from the artisan's own
# SMTP set via mail-settings above. Leave unset to run prod with these
# emails disabled (POST /auth/forgot-password and /auth/resend-verification
# reply 503) — registration/login still work normally without it.
# SYSTEM_SMTP_HOST=<your-smtp-provider-host>
# SYSTEM_SMTP_PORT=587
# SYSTEM_SMTP_SECURE=false
# SYSTEM_SMTP_USER=<your-system-mailbox-username>
# SYSTEM_SMTP_PASSWORD=<your-system-mailbox-password-or-app-password>
# SYSTEM_MAIL_FROM_NAME=FactureLe
# SYSTEM_MAIL_FROM_ADDRESS=<address-emails-are-sent-from>

# Set explicitly (error/warn/info/http/debug) to turn on Prisma query
# logging, or otherwise raise/lower prod verbosity, without a redeploy.
# Defaults to 'info' in production. See docs/logging.md.
# LOG_LEVEL=info

# Phase 14 Stripe subscription billing, 3 tiers as of Phase 30 (Essentiel
# 7€ / Pro 12€ / Premium 15€ — see docs/roadmap.md Phase 30's "Stripe
# dashboard setup" section for how to create the 3 Prices, in both test and
# live mode). Leave STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET unset to run
# prod with billing disabled (POST /billing/checkout-session, /portal-session
# and /webhook reply 503) — the free-trial gate still blocks a company's 2nd
# invoice, there's just no way to pay to lift it yet. Each price id below is
# independently optional: set only STRIPE_PRICE_ID_PREMIUM to reproduce the
# pre-Phase-30 single-tier behavior exactly.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=<whsec_...>
# STRIPE_PRICE_ID_ESSENTIEL=<price_...>
# STRIPE_PRICE_ID_PRO=<price_...>
# STRIPE_PRICE_ID_PREMIUM=<price_...>

# Phase 30: time-boxed "offre de lancement" on Premium only (15€ -> 10€ for
# 2 months). Leave unset to keep the offer off. ISO 8601 date.
# LAUNCH_OFFER_EXPIRES_AT=2026-10-01T00:00:00Z

# Phase 1.2-4 e-invoicing transmission (SUPER PDP, the chosen PA — see
# docs/roadmap.md Phase 1.2-1). Leave unset to run with PA transmission
# disabled — Factur-X download (Phase 1.2-3) still works normally without
# it. See backend/.env.example's own comment for the account-setup steps.
# SUPERPDP_CLIENT_ID=
# SUPERPDP_CLIENT_SECRET=
# SUPERPDP_REDIRECT_URI=https://your-domain.example/api/company/super-pdp/callback

# Phase 21 certificate-expiry monitoring (infra/check-cert-expiry.sh, run via
# cron — see docs/deployment.md). Sends its alert over the SYSTEM_SMTP_*
# credentials already configured above (plain SMTP, not a provider API) —
# the only new value needed here is where to send the alert. Leave
# OPS_ALERT_EMAIL unset to run the probe with alerting disabled (it still
# logs to stdout/cron log, just can't email).
# OPS_ALERT_EMAIL=<your-own-email-address>
# CERT_EXPIRY_WARN_DAYS=14
