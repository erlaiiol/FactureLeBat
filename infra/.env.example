POSTGRES_USER=facturelebat
# Dev-only default. In infra/.env on a real server, use a strong, unique
# password — never this one (see docs/deployment.md).
POSTGRES_PASSWORD=facturelebat
POSTGRES_DB=facturelebat
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=4200

CORS_ORIGIN=http://localhost:4200

# infra/docker-compose.prod.yml only (Caddy edge). Leave as `:80` for local
# `make prod` smoke-testing (plain HTTP, no cert requested). On the real OVH
# deployment, set this to the domain's A record, e.g. facturelebat.example.com
# — Caddy then requests/renews its Let's Encrypt certificate automatically.
# See docs/deployment.md.
DOMAIN=:80
