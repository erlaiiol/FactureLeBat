POSTGRES_USER=facturelebat
# Dev-only default. In infra/.env on a real server, use a strong, unique
# password — never this one (see docs/deployment.md).
POSTGRES_PASSWORD=facturelebat
POSTGRES_DB=facturelebat
POSTGRES_PORT=5432

BACKEND_PORT=3000
FRONTEND_PORT=4200

CORS_ORIGIN=http://localhost:4200

# infra/docker-compose.prod.yml only (Caddy edge). Leave as `:80` for local
# `make prod` smoke-testing (plain HTTP, no cert requested). On the real OVH
# deployment, set this to the domain's A record, e.g. facturelebat.example.com
# — Caddy then requests/renews its Let's Encrypt certificate automatically.
# See docs/deployment.md.
DOMAIN=:80

# Phase 13 auth — required, prod will not boot without it (see
# backend/.env.example for how to generate one and the full set of optional
# auth-related vars: JWT_*, FRONTEND_URL, GOOGLE_CLIENT_*, SYSTEM_SMTP_*).
# infra/docker-compose.prod.yml's backend service loads this whole file via
# env_file, so anything from backend/.env.example can also be set here for
# prod (GROQ_API_KEY, APP_ENCRYPTION_KEY, JWT_ACCESS_SECRET, ...).
JWT_ACCESS_SECRET=
# On the real deployment this should be the public HTTPS origin (the DOMAIN
# above, with scheme), e.g. https://facturelebat.example.com — used to
# build the links in verification/password-reset emails and the
# post-Google-login redirect.
FRONTEND_URL=http://localhost
