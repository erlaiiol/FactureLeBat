# Cloudflare's published edge IP ranges (https://www.cloudflare.com/ips/) —
# inert until DNS actually gets proxied through Cloudflare (see
# docs/deployment.md's Cloudflare section); harmless either way, since Caddy
# only special-cases a connecting peer whose address falls in this list.
# Once proxying is on, this lets Caddy trust the X-Forwarded-For Cloudflare
# sets (the real visitor IP) instead of discarding it, so it survives the
# rest of the chain (-> nginx -> Nest) for logging/rate-limiting. Re-check
# this list against the URL above occasionally — Cloudflare rarely changes
# it, but "rarely" isn't "never".
{
	servers {
		trusted_proxies static \
 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 \
 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 \
 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 \
 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 \
 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Public edge for infra/docker-compose.prod.yml. Terminates TLS and proxies
# everything to the frontend Nginx container, which keeps doing exactly what
# it does today (serve the Angular build, proxy /api/* to the backend) — see
# infra/nginx.conf. Caddy owns exactly one job: public exposure + certs.
#
# {$DOMAIN} (infra/.env) drives the behavior:
#   - a real domain (e.g. facturele.example.com) -> automatic HTTPS via
#     Let's Encrypt, HTTP->HTTPS redirect, cert renewal, all built in.
#   - `:80` (the local/`make prod` smoke-test default) -> plain HTTP on port
#     80, no ACME attempt (Caddy never requests a cert for a bare port).
{$DOMAIN}

encode gzip

# Phase 21 hardening. CSP is deliberately hand-fitted to what this app
# actually loads, confirmed by reading the frontend rather than assumed:
#   - script-src 'self', plus one 'sha256-...' hash: no CDN scripts, no
#     Stripe.js/Google Identity script (checkout/OAuth are both full-page
#     redirects via window.location/<a href>, never an embedded SDK — see
#     billing/subscribe.page.ts, auth.service.ts#googleLoginUrl), no JIT eval
#     in an AOT prod build. The one exception is index.html's JSON-LD
#     structured-data <script> (SEO quick win, 2026-08-31) — allow-listed by
#     content hash rather than 'unsafe-inline' so nothing else inline can run;
#     see index.html's own comment for how to regenerate the hash if that
#     block's content ever changes.
#   - style-src needs 'unsafe-inline': the tour overlay (tour-position.util),
#     manual-invoice column/row resize (interactjs), and the line-marking
#     badge all set inline `style.*` via JS at runtime — a legitimate,
#     first-party pattern this app relies on, not third-party content. CSS
#     injection alone can't execute script in a modern browser, so this is a
#     much smaller concession than allowing 'unsafe-inline' on script-src
#     would be.
#   - frame-src 'self' blob:: the invoice PDF preview renders into an
#     <iframe [src]> pointed at a client-generated blob: URL
#     (pdf-preview-modal.component.html) — nothing external is ever framed.
#   - connect-src 'self' blob:: on Safari/iOS/Capacitor (WKWebView),
#     pdf-canvas-viewer.component.ts's fetch() of that same blob: URL — to
#     hand the bytes to pdf.js, since those platforms can't render the PDF
#     iframe natively — is itself subject to connect-src. WebKit enforces
#     this even for a blob: URL the page created itself; Chromium doesn't,
#     which is why this was only ever noticed on Safari ("Refused to
#     connect to blob:...").
#   - frame-ancestors 'none' + X-Frame-Options DENY: this app is never meant
#     to be embedded by anyone, belt-and-suspenders for older browsers that
#     don't honor frame-ancestors.
#   - No upgrade-insecure-requests: would force every subresource to https
#     even when Caddy is serving the local `:80` smoke-test fallback (no TLS
#     listener there), breaking `make prod` locally. HSTS already covers the
#     real-domain case once a cert exists.
#
# This CSP was verified against a real headless-browser run of the built
# prod image (Playwright, console `securitypolicyviolation` events), not
# just reasoned about — that run caught a genuine break: Angular's
# production build (via `beasties`) by default rewrites the main stylesheet
# `<link>` into `media="print" onload="this.media='all'"` to defer non-
# critical CSS — an inline event-handler attribute that `script-src 'self'`
# blocks outright, which would have shipped as an unstyled page. Fixed by
# setting `optimization.styles.inlineCritical: false` in
# `frontend/angular.json`'s production config — don't re-enable it without
# re-verifying against this CSP.
header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	X-Frame-Options "DENY"
	Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-hfyn496X7xHhGggIoWQrolBO3W5kI3GzyuMP0SRyPBE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' blob:; frame-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
	-Server
}

reverse_proxy frontend:80
